# Tax2Biz Environment Configuration
APP_NAME=Tax2Biz
APP_ENV=development
DEBUG=true
PORT=8085
HOST=0.0.0.0

# Database Configuration (Defaults to zero-config local async SQLite; switch to PostgreSQL in prod)
DATABASE_URL=sqlite+aiosqlite:///./tax2biz.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tax2biz

# CORS: Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8085,http://127.0.0.1:8085,https://tax2biz.in,https://www.tax2biz.in

# Mode configurations: "DEMO" or "LIVE"
PAYMENT_MODE=DEMO
NOTIFICATION_MODE=DEMO

# Razorpay (When ready to go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / WhatsApp Gateway (When ready to go live)
SMS_PROVIDER=DEMO
SMS_API_KEY=
WHATSAPP_API_KEY=

# TradeMarx Trademark Search API Key (Preserved from existing setup)
TRADEMARX_API_KEY=trmx_live_pk_09f3e1a8b74c2d6e5a0198
